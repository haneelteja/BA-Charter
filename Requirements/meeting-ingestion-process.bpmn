<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_BAWorkbench"
                  targetNamespace="http://ba-workbench.internal/bpmn">

  <bpmn:process id="Process_MeetingIngestion" name="Meeting Ingestion to Minutes" isExecutable="false">

    <bpmn:startEvent id="StartEvent_1" name="Source received">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Normalise" name="Normalise and index source">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Extract" name="Extract candidate decisions and actions">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Review" name="Business Analyst confirms candidates">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Contradiction" name="Contradictions resolved">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Resolve" name="Lead BA resolves contradiction">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Minutes" name="Generate minutes of meeting">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Approve" name="Lead BA approves minutes">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Distribute" name="Distribute minutes by email">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Commit" name="Commit decisions to knowledge model">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Spawn" name="Create action and clarification cases">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Meeting processed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_Normalise" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Normalise" targetRef="Task_Extract" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Extract" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Review" targetRef="Gateway_Contradiction" />
    <bpmn:sequenceFlow id="Flow_05" name="No" sourceRef="Gateway_Contradiction" targetRef="Task_Resolve" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Resolve" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_07" name="Yes" sourceRef="Gateway_Contradiction" targetRef="Task_Minutes" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Minutes" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Approve" targetRef="Task_Distribute" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Distribute" targetRef="Task_Commit" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Commit" targetRef="Task_Spawn" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Spawn" targetRef="EndEvent_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_MeetingIngestion">

      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="118" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Normalise" bpmnElement="Task_Normalise">
        <dc:Bounds x="230" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Extract" bpmnElement="Task_Extract">
        <dc:Bounds x="380" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Review" bpmnElement="Task_Review">
        <dc:Bounds x="530" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Contradiction" bpmnElement="Gateway_Contradiction" isMarkerVisible="true">
        <dc:Bounds x="690" y="111" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Resolve" bpmnElement="Task_Resolve">
        <dc:Bounds x="660" y="250" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Minutes" bpmnElement="Task_Minutes">
        <dc:Bounds x="790" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Approve" bpmnElement="Task_Approve">
        <dc:Bounds x="940" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Distribute" bpmnElement="Task_Distribute">
        <dc:Bounds x="1090" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Commit" bpmnElement="Task_Commit">
        <dc:Bounds x="1240" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Spawn" bpmnElement="Task_Spawn">
        <dc:Bounds x="1390" y="96" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="1550" y="118" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="188" y="136" />
        <di:waypoint x="230" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="340" y="136" />
        <di:waypoint x="380" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="490" y="136" />
        <di:waypoint x="530" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="640" y="136" />
        <di:waypoint x="690" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="715" y="161" />
        <di:waypoint x="715" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="660" y="290" />
        <di:waypoint x="585" y="290" />
        <di:waypoint x="585" y="176" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="740" y="136" />
        <di:waypoint x="790" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="900" y="136" />
        <di:waypoint x="940" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1050" y="136" />
        <di:waypoint x="1090" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1200" y="136" />
        <di:waypoint x="1240" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1350" y="136" />
        <di:waypoint x="1390" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1500" y="136" />
        <di:waypoint x="1550" y="136" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
