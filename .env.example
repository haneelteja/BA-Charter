# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/publishable key (Project Settings → API) — safe for the browser, RLS
# still applies under the signed-in user's identity.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings → API) — server-only, bypasses RLS.
# Used only by trusted server code (background worker, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts per-user LLM API keys at rest (src/lib/crypto.ts). Generate with:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Resend (resend.com) — outbound email: minutes, clarification requests, change notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
