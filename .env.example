# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/publishable key (Project Settings → API) — safe for the browser, RLS
# still applies under the signed-in user's identity.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings → API) — server-only, bypasses RLS.
# Used only by trusted server code (background worker, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts per-user LLM API keys at rest (src/lib/crypto.ts). Generate with:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Resend (resend.com) — outbound email: minutes, clarification requests, change notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Authenticates Vercel Cron's calls to /api/cron/sweeps (Vercel auto-sends this
# value as "Authorization: Bearer <value>" to its own cron invocations once set
# as an env var — not needed locally unless you're testing the route by hand).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Agile Studio (EPIC 14) — leave unset to keep using the stub client
# (src/lib/agileStudio/client.ts); only set AGILE_STUDIO_BASE_URL once a
# real Pega Infinity + Agile Studio instance exists, which switches
# getAgileStudioClient() over to the real REST client automatically.
# AGILE_STUDIO_TOKEN_URL is that instance's OAuth2 token endpoint for a
# Client Credentials-grant client registration (Dev Studio → Org & Resources
# → Integration → OAuth 2.0 Client Registrations). The case type names are
# a guess — see src/lib/agileStudio/restClient.ts's header comment.
AGILE_STUDIO_BASE_URL=
AGILE_STUDIO_TOKEN_URL=
AGILE_STUDIO_CLIENT_ID=
AGILE_STUDIO_CLIENT_SECRET=
AGILE_STUDIO_EPIC_CASE_TYPE=
AGILE_STUDIO_STORY_CASE_TYPE=
